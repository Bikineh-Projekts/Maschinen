@using MaschinenDataein.Helper
@using MaschinenDataein.Models.ModelView
@using MaschinenDataein.Models.PaginatedModel
@model List<TemperaturdatenModelView>

@{
    bool IsShowId = Convert.ToBoolean(ViewData["IsShowId"]);
    var paginatedListItem = ViewData["PaginatedListItem"] as PaginatedListItem;

    // REGEL (siehe SiteHelper): NUR Isstemp2 ÷ 10, alle anderen unverändert
    string Temp(decimal grad) => SiteHelper.Text(grad) + " °C";
}

@if (Model != null && Model.Count > 0)
{
    <div class="tabelle-karte">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        @if (IsShowId)
                        {
                            <th class="text-end">ID</th>
                        }
                        <th>Zeitstempel</th>
                        <th>Maschine</th>
                        <th>PR-Name</th>
                        <th class="text-end">Soll 1</th>
                        <th class="text-end">Unterfolie (Ist 1)</th>
                        <th class="text-end">Soll 2</th>
                        <th class="text-end">Oberfolie (Ist 2)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var TemperaturDaten in Model)
                    {
                        <tr>
                            @if (IsShowId)
                            {
                                <td class="text-end text-muted">@TemperaturDaten.Id</td>
                            }
                            <td class="zeit-datum">
                                @TemperaturDaten.Timestamp.ToString("dd.MM.yyyy")<span class="zeit-uhr">@TemperaturDaten.Timestamp.ToString("HH:mm:ss")</span>
                            </td>
                            <td>@(TemperaturDaten.Maschine ?? "–")</td>
                            <td>@(string.IsNullOrWhiteSpace(TemperaturDaten.Name) ? "–" : TemperaturDaten.Name)</td>
                            <td class="text-end text-muted">@Temp(SiteHelper.Temperatur(TemperaturDaten.Solltemp1))</td>
                            <td class="text-end fw-semibold">@Temp(SiteHelper.Temperatur(TemperaturDaten.Isstemp1))</td>
                            <td class="text-end text-muted">@Temp(SiteHelper.Temperatur(TemperaturDaten.Solltemp2))</td>
                            <td class="text-end fw-semibold">@Temp(SiteHelper.Isstemp2(TemperaturDaten.Isstemp2))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (paginatedListItem != null)
        {
            @await Html.PartialAsync("_PaginatedItem", paginatedListItem)
        }
    </div>
}
else
{
    @await Html.PartialAsync("_LeerHinweis", Model != null)
}
