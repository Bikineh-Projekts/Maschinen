@using MaschinenDataein.Helper
@using MaschinenDataein.Models.ModelView
@using MaschinenDataein.Models.PaginatedModel
@model List<AbzugsdatenModelView>

@{
    bool IsShowId = Convert.ToBoolean(ViewData["IsShowId"]);
    var paginatedListItem = ViewData["PaginatedListItem"] as PaginatedListItem;
}

@if (Model != null && Model.Count > 0)
{
    <div class="tabelle-karte">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        @if (IsShowId)
                        {
                            <th class="text-end">Id</th>
                        }
                        <th>Zeitstempel</th>
                        <th>Maschine</th>
                        <th>PR-Name</th>
                        <th class="text-end">Packungen pro Abzug</th>
                        <th class="text-end">Abzuglänge</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var AbzugsDaten in Model)
                    {
                        <tr>
                            @if (IsShowId)
                            {
                                <td class="text-end text-muted">@AbzugsDaten.Id</td>
                            }
                            <td class="zeit-datum">
                                @AbzugsDaten.Timestamp.ToString("dd.MM.yyyy")<span class="zeit-uhr">@AbzugsDaten.Timestamp.ToString("HH:mm:ss")</span>
                            </td>
                            <td>@(AbzugsDaten.Maschine ?? "–")</td>
                            <td>@(string.IsNullOrWhiteSpace(AbzugsDaten.Name) ? "–" : AbzugsDaten.Name)</td>
                            <td class="text-end">@AbzugsDaten.PackungenproAbzug.ToString("N0") Stück</td>
                            <td class="text-end">@((AbzugsDaten.Abzuglaenge / 10.0).ToString("N1")) mm</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (paginatedListItem != null)
        {
            @await Html.PartialAsync("_PaginatedItem", paginatedListItem)
        }
    </div>
}
else
{
    @await Html.PartialAsync("_LeerHinweis", Model != null)
}
