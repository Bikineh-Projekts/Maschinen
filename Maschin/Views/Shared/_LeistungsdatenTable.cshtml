@using MaschinenDataein.Models.ModelView
@using MaschinenDataein.Models.PaginatedModel
@model List<LeistungsdatenModelView>

@{
    bool IsShowId = Convert.ToBoolean(ViewData["IsShowId"]);
    PaginatedListItem? pagInfo = ViewData["PaginatedListItem"] as PaginatedListItem;
}

@if (Model != null && Model.Count > 0)
{
    <div class="tabelle-karte">
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle">
            <thead class="table-dark text-center">
                <tr>
                    @if (IsShowId)
                    {
                        <th style="width:60px">ID</th>
                    }
                    <th>Zeitstempel</th>
                    <th>Maschine</th>
                    <th>Programm</th>
                    <th>Tagesz.</th>
                    <th>Takte</th>
                    <th>Packungen</th>
                    <th>Takte-Balken</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int maxTakte = Model.Any() ? Model.Max(x => x.Maschinentakte) : 1;
                    if (maxTakte < 1) maxTakte = 1;
                }

                @foreach (var item in Model)
                {
                    int pct = (int)(item.Maschinentakte * 100.0 / maxTakte);

                    // Statusstufe statt Farbwert: Farbe kommt aus dem Farbsystem
                    string stufe = pct >= 80 ? "gut" : pct >= 40 ? "warnung" : "kritisch";

                    <tr>
                        @if (IsShowId)
                        {
                            <td class="text-center text-muted">@item.Id</td>
                        }

                        <td class="zeit-datum">
                            @item.Timestamp.ToString("dd.MM.yyyy")<span class="zeit-uhr">@item.Timestamp.ToString("HH:mm:ss")</span>
                        </td>

                        <td class="text-center">@(item.Maschine ?? "–")</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Name) ? "–" : item.Name)</td>

                        <td class="text-end">@item.Tagestaktzaehler.ToString("N0")</td>
                        <td class="text-end fw-bold">@item.Maschinentakte.ToString("N0")</td>
                        <td class="text-end">@item.Packungszaehler.ToString("N0")</td>

                        <td>
                            <div class="leistungs-balken @stufe" title="@pct % der höchsten Taktzahl auf dieser Seite">
                                <div class="spur"><div class="fuellung" style="width:@(pct)%"></div></div>
                                <span class="wert">@(pct)%</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (pagInfo != null)
    {
        @await Html.PartialAsync("_PaginatedItem", pagInfo)
    }
    </div>
}
else
{
    @await Html.PartialAsync("_LeerHinweis", Model != null)
}
