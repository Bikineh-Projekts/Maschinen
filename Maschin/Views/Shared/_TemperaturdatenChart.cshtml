
<style>
    .td-dashboard {
        background: var(--md-flaeche);
        border: 1px solid var(--md-rand);
        border-radius: 10px;
        padding: 24px;
        color: var(--md-text);
        font-family: inherit;
        min-height: 400px;
    }
    .td-stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
        gap: 12px;
        margin-bottom: 20px;
    }
    .td-stat-card {
        background: var(--md-flaeche-3);
        border: 1px solid var(--md-rand);
        border-radius: 10px;
        padding: 14px 18px;
    }
    .td-stat-label {
        font-size: 10px;
        color: var(--md-text-2);
        
        margin-bottom: 4px;
    }
    .td-stat-value {
        font-size: 26px;
        font-weight: 700;
        font-variant-numeric:tabular-nums;
    }
    .td-stat-unit { font-size: 13px; margin-left: 3px; color: var(--md-text-2); }
    .td-stat-sub  { font-size: 10px; color: var(--md-text-2); margin-top: 3px; }
    .td-chart-box {
        background: var(--md-flaeche-2);
        border: 1px solid var(--md-rand);
        border-radius: 12px;
        padding: 16px 16px 10px;
        margin-bottom: 14px;
    }
    .td-chart-title { font-size: 12px; color: var(--md-text-2); margin-bottom: 12px; }
    .td-btns { display: flex; gap: 6px; margin-bottom: 16px; flex-wrap: wrap; }
    .td-btn {
        padding: 7px 16px;
        border-radius: 8px;
        border: 1px solid var(--md-rand);
        background: transparent;
        color: var(--md-text-2);
        cursor: pointer;
        font-size: 13px;
        transition: all 0.15s;
    }
    .td-btn.k-active {
        background: color-mix(in srgb, var(--md-akzent) 13%, transparent);
        border-color: var(--md-akzent);
        color: var(--md-akzent);
        font-weight: 600;
    }
    .td-btn.a-active {
        background: color-mix(in srgb, var(--status-gut-text) 13%, transparent);
        border-color: var(--status-gut-text);
        color: var(--status-gut-text);
        font-weight: 600;
    }
    .td-info {
        background: var(--md-flaeche-3);
        border: 1px solid var(--md-rand);
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 12px;
        color: var(--md-text-2);
        line-height: 1.7;
    }
    .td-info b { color: var(--md-text); display: block; margin-bottom: 5px; }
    .td-loader {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 220px;
        color: var(--md-text-2);
        font-size: 14px;
        gap: 10px;
    }
    .td-spin {
        width: 20px; height: 20px;
        border: 2px solid var(--md-rand);
        border-top-color: var(--md-akzent);
        border-radius: 50%;
        animation: tdspin 0.8s linear infinite;
    }
    @@keyframes tdspin { to { transform: rotate(360deg); } }
    @@media (max-width: 640px) {
        .td-dashboard { padding: 12px; }
        .td-stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
        .td-stat-card { padding: 10px; min-width: 0; }
        .td-stat-value { font-size: 20px; overflow-wrap: anywhere; }
        .td-btns { gap: 5px; }
        .td-btn { flex: 1 1 auto; padding: 8px 10px; font-size: 12px; }
        .td-chart-box { padding: 10px; }
    }
    .td-empty {
        padding: 32px;
        color: var(--md-text-2);
        font-size: 14px;
        text-align: center;
        line-height: 1.8;
    }
    .td-debug {
        margin-top: 12px;
        padding: 10px 14px;
        background: var(--md-flaeche-3);
        border: 1px solid var(--md-rand);
        border-radius: 8px;
        font-variant-numeric:tabular-nums;
        font-size: 11px;
        color: var(--md-text-3);
        text-align: left;
    }
    .td-reload-btn {
        margin-top: 14px;
        padding: 8px 22px;
        background: color-mix(in srgb, var(--md-akzent) 13%, transparent);
        border: 1px solid var(--md-akzent);
        color: var(--md-akzent);
        border-radius: 8px;
        cursor: pointer;
        font-size: 13px;
    }
</style>

<div id="tdRoot" class="td-dashboard">
    <div class="td-loader">
        <div class="td-spin"></div>
        Lade Temperaturdaten ...
    </div>
</div>

<script>
(function () {

    // ── State ────────────────────────────────────────────────────────────────
    let _daten    = null;
    let _kanal    = 1;
    let _ansicht  = 'verlauf';
    let _chart    = null;

    // ── Farben ───────────────────────────────────────────────────────────────
    // Farben aus dem Farbsystem – werden beim Zeichnen gelesen, passen also zu Hell und Dunkel
    const C = {
        get soll()   { return mdFarbe('viz-1'); },
        get ist()    { return mdFarbe('viz-2'); },
        get fehler() { return mdFarbe('viz-3'); },
        get neg()    { return mdFarbe('status-kritisch'); },
        get warn()   { return mdFarbe('status-warnung'); },
        get muted()  { return mdFarbe('md-text-2'); },
        get border() { return mdFarbe('viz-raster'); },
        get purple() { return mdFarbe('viz-7'); },
    };

    // ════════════════════════════════════════════════════════════════════════
    // Filter-Werte lesen
    //
    // _PartialFilter hat hidden fields:
    //   <input type="hidden" id="DatumVon" value="yyyy-MM-dd" />
    //   <input type="hidden" id="DatumBis" value="yyyy-MM-dd" />
    //
    // updateDate() in _PartialFilter aktualisiert diese automatisch
    // wenn der User einen Dropdown ändert.
    // Wir lesen einfach diese hidden fields — fertig, kein DOM-Raten mehr.
    // ════════════════════════════════════════════════════════════════════════
    function leseFilter() {
        // Hidden fields aus _PartialFilter direkt lesen
        // Diese werden von updateDate() aktuell gehalten
        const datumVon    = document.getElementById('DatumVon')?.value    || '';
        const datumBis    = document.getElementById('DatumBis')?.value    || '';
        const maschinenId = document.getElementById('MaschinenId')?.value || '0';

        return { datumVon, datumBis, maschinenId };
    }

    // Daten laden — öffentliche Funktion, aufgerufen vom Tab-onclick
    // ════════════════════════════════════════════════════════════════════════
    window.ladeChartDaten = function (force) {
        if (_daten && !force) return;
        _daten = null;

        document.getElementById('tdRoot').innerHTML =
            '<div class="td-loader"><div class="td-spin"></div>Lade Temperaturdaten ...</div>';

        const f  = leseFilter();
        const qs = [];
        if (f.datumVon)                      qs.push('datumVon='    + encodeURIComponent(f.datumVon));
        if (f.datumBis)                      qs.push('datumBis='    + encodeURIComponent(f.datumBis));
        if (f.maschinenId && f.maschinenId !== '0')
                                             qs.push('maschinenId=' + encodeURIComponent(f.maschinenId));

        const url = '/TemperaturDaten/GetChartData' + (qs.length ? '?' + qs.join('&') : '');

        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => {
                if (!r.ok) throw new Error('Server antwortete mit HTTP ' + r.status);
                return r.json();
            })
            .then(json => {
                _daten = json;

                if (!json.punkte || json.punkte.length === 0) {
                    const dbg = json.debug || {};
                    document.getElementById('tdRoot').innerHTML = `
                        <div class="td-empty">
                            <div style="font-size:36px;margin-bottom:12px">📭</div>
                            <div style="font-size:16px;color:var(--md-text);margin-bottom:8px">
                                Keine Daten im gewählten Zeitraum
                            </div>
                            <div style="font-size:13px">
                                Bitte Datumsbereich oder Maschine anpassen,
                                <strong style="color:var(--md-akzent)">Filtern</strong> klicken
                                und danach erneut auf
                                <strong style="color:var(--status-gut-text)">📊 Analyse-Diagramm</strong> wechseln.
                            </div>
                            <div class="td-debug">
                                🔍 Abgefragter Zeitraum:
                                <span style="color:var(--md-akzent)">${dbg.datumVonVerwendet || '?'}</span>
                                bis
                                <span style="color:var(--md-akzent)">${dbg.datumBisVerwendet || '?'}</span>
                                &nbsp;·&nbsp; Maschinen-ID:
                                <span style="color:var(--status-ernst-text)">${dbg.maschinenIdFilter || 'alle'}</span>
                                &nbsp;·&nbsp; Datenbankzeilen:
                                <span style="color:var(--status-kritisch-text)">${dbg.gesamtPunkteDatenbank ?? 0}</span>
                            </div>
                            <button class="td-reload-btn" onclick="ladeChartDaten(true)">🔄 Neu laden</button>
                        </div>`;
                    return;
                }

                renderDashboard();
            })
            .catch(err => {
                document.getElementById('tdRoot').innerHTML = `
                    <div class="td-empty">
                        <div style="font-size:32px;margin-bottom:10px;color:var(--status-kritisch-text)">❌</div>
                        <div style="font-size:15px;color:var(--md-text);margin-bottom:6px">Fehler beim Laden</div>
                        <div class="td-debug" style="color:var(--status-kritisch-text)">
                            ${err.message}<br>
                            <span style="color:var(--md-text-3)">Endpoint: ${url}</span>
                        </div>
                        <div style="margin-top:10px;font-size:12px;color:var(--md-text-2)">
                            Prüfe ob <code style="color:var(--status-ernst-text)">GetChartData</code>
                            im Controller existiert und die App läuft.
                        </div>
                        <button class="td-reload-btn" style="border-color:var(--status-kritisch-text);color:var(--status-kritisch-text);background:color-mix(in srgb, var(--status-kritisch-text) 7%, transparent)"
                            onclick="ladeChartDaten(true)">🔄 Erneut versuchen</button>
                    </div>`;
            });
    };

    // ════════════════════════════════════════════════════════════════════════
    // Histogramm-Daten berechnen
    // ════════════════════════════════════════════════════════════════════════
    function buildHist(key) {
        const bins = {};
        for (let b = -8; b <= 8; b++) bins[b] = 0;
        _daten.punkte.forEach(p => {
            const b = Math.round(Math.max(-8, Math.min(8, p[key])));
            if (b in bins) bins[b]++;
        });
        return {
            labels: Object.keys(bins).map(k => k + '°C'),
            counts: Object.values(bins)
        };
    }

    // ════════════════════════════════════════════════════════════════════════
    // Chart zeichnen
    // ════════════════════════════════════════════════════════════════════════
    function drawChart() {
        if (_chart) { _chart.destroy(); _chart = null; }

        const canvas = document.getElementById('tdCanvas');
        if (!canvas) return;

        const sollKey   = _kanal === 1 ? 'soll1'   : 'soll2';
        const istKey    = _kanal === 1 ? 'ist1'    : 'ist2';
        const fehlerKey = _kanal === 1 ? 'fehler1' : 'fehler2';
        const punkte    = _daten.punkte;
        const labels    = punkte.map(p => p.t);
        const s         = _kanal === 1 ? _daten.statistik.kanal1 : _daten.statistik.kanal2;
        // Bei der Auswahl "Beide Maschinen" werden Messreihen getrennt dargestellt,
        // damit keine Linie Messwerte unterschiedlicher Maschinen miteinander verbindet.
        const maschinen = [...new Map(punkte.map(p => [p.maschinenId, p.maschine || `Maschine ${p.maschinenId}`])).entries()];
        const datenJeMaschine = (id, key) => punkte.map(p => p.maschinenId === id ? p[key] : null);
        const maschinenFarbe = i => mdFarbe(`viz-${(i % 8) + 1}`);

        Chart.defaults.color = C.muted;

        const baseOpts = {
            responsive: true,
            maintainAspectRatio: false,
            animation: { duration: 250 },
            plugins: {
                legend: { labels: { color: C.muted, font: { size: 12 }, boxWidth: 20 } },
                tooltip: {
                    backgroundColor: mdFarbe('md-tooltip'),
                    borderColor: C.border,
                    borderWidth: 1,
                    titleColor: mdFarbe('md-tooltip-text'),
                    bodyColor: mdFarbe('md-tooltip-text'),
                    callbacks: { label: c => ` ${c.dataset.label}: ${c.parsed.y}°C` }
                }
            },
            scales: {
                x: {
                    ticks: { color: C.muted, maxTicksLimit: 10, font: { size: 10 } },
                    grid:  { color: C.border + '55' }
                },
                y: {
                    ticks: { color: C.muted, font: { size: 10 } },
                    grid:  { color: C.border + '55' },
                    title: { display: true, text: '°C', color: C.muted }
                }
            }
        };

        if (_ansicht === 'verlauf') {
            _chart = new Chart(canvas.getContext('2d'), {
                type: 'line',
                data: {
                    labels,
                    datasets: maschinen.flatMap(([id, name], i) => {
                        const farbe = maschinenFarbe(i);
                        return [
                            {
                                label: `${name} · Soll${_kanal}`,
                                data: datenJeMaschine(id, sollKey),
                                borderColor: farbe,
                                backgroundColor: 'transparent',
                                borderDash: [6, 3],
                                borderWidth: 1.5,
                                pointRadius: 0,
                                spanGaps: true,
                                fill: false,
                                tension: 0.2
                            },
                            {
                                label: `${name} · Ist${_kanal}`,
                                data: datenJeMaschine(id, istKey),
                                borderColor: farbe,
                                backgroundColor: 'transparent',
                                borderWidth: 2.5,
                                pointRadius: 0,
                                spanGaps: true,
                                tension: 0.2
                            }
                        ];
                    })
                },
                options: baseOpts
            });

        } else if (_ansicht === 'fehler') {
            _chart = new Chart(canvas.getContext('2d'), {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        ...maschinen.map(([id, name], i) => ({
                            label: `${name} · Fehler Kanal${_kanal}`,
                            data: datenJeMaschine(id, fehlerKey),
                            borderColor: maschinenFarbe(i),
                            backgroundColor: 'transparent',
                            borderWidth: 1.8,
                            pointRadius: 0,
                            spanGaps: true,
                            fill: false,
                            tension: 0.2
                        })),
                        {
                            label: `Bias aller ausgewählten Maschinen (${s.bias} °C)`,
                            data: labels.map(() => s.bias),
                            borderColor: C.warn,
                            borderDash: [5, 4],
                            borderWidth: 1.5,
                            pointRadius: 0,
                            fill: false
                        },
                        {
                            label: 'Nulllinie',
                            data: labels.map(() => 0),
                            borderColor: mdFarbe('md-rand'),
                            borderWidth: 1,
                            pointRadius: 0,
                            fill: false
                        }
                    ]
                },
                options: {
                    ...baseOpts,
                    scales: {
                        ...baseOpts.scales,
                        y: { ...baseOpts.scales.y, title: { display: true, text: 'ΔT (°C)', color: C.muted } }
                    }
                }
            });

        } else if (_ansicht === 'histogramm') {
            const hist = buildHist(fehlerKey);
            _chart = new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: hist.labels,
                    datasets: [{
                        label: 'Häufigkeit',
                        data: hist.counts,
                        backgroundColor: C.soll + 'bb',
                        borderColor: C.soll,
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    ...baseOpts,
                    scales: {
                        x: { ...baseOpts.scales.x, title: { display: true, text: 'Fehler (°C)', color: C.muted } },
                        y: { ...baseOpts.scales.y, title: { display: true, text: 'Anzahl', color: C.muted } }
                    }
                }
            });
        }
    }

    // ════════════════════════════════════════════════════════════════════════
    // Interpretation
    // ════════════════════════════════════════════════════════════════════════
    function interpText() {
        const s = _kanal === 1 ? _daten.statistik.kanal1 : _daten.statistik.kanal2;
        const ab = Math.abs(s.bias);

        const bColor = ab < 1 ? C.fehler : ab < 3 ? C.warn : C.neg;
        const bText  = ab < 1 ? '✅ Sehr gute Kalibrierung'
                     : ab < 3 ? '⚠️ Leichte Abweichung — Sensor-Kalibrierung prüfen'
                     :          '❌ Systematischer Fehler — Heizung/Sensor defekt?';

        const rColor = s.rmse < 2 ? C.fehler : s.rmse < 5 ? C.warn : C.neg;
        const rText  = s.rmse < 2 ? '✅ Stabile Regelung'
                     : s.rmse < 5 ? '⚠️ Mäßige Stabilität'
                     :              '❌ Instabile Regelung — PID prüfen';

        const dbg = _daten.debug || {};

        return `
            <div class="td-info">
                <b>💡 Automatische Interpretation — Kanal ${_kanal}</b>
                Bias: <strong style="color:${bColor}">${s.bias}°C</strong> → ${bText}
                &nbsp;·&nbsp;
                RMSE: <strong style="color:${rColor}">${s.rmse}°C</strong> → ${rText}
                <div style="margin-top:8px;font-size:10px;color:var(--md-text-3)">
                    Zeitraum: ${dbg.datumVonVerwendet || '–'} – ${dbg.datumBisVerwendet || '–'}
                    &nbsp;·&nbsp; Datenbankpunkte: ${dbg.gesamtPunkteDatenbank ?? '–'}
                    &nbsp;·&nbsp; Dargestellt: ${dbg.dargestelltePunkte ?? _daten.punkte.length}
                </div>
            </div>`;
    }

    // ════════════════════════════════════════════════════════════════════════
    // Dashboard komplett rendern
    // ════════════════════════════════════════════════════════════════════════
    function renderDashboard() {
        // Anzahl Maschinen hier selbst ermitteln – 'maschinen' existiert nur in drawChart()
        const anzahlMaschinen = new Set((_daten.punkte || []).map(p => p.maschinenId)).size;
        const s = _kanal === 1 ? _daten.statistik.kanal1 : _daten.statistik.kanal2;

        function sc(label, value, unit, color, sub) {
            return `<div class="td-stat-card">
                <div class="td-stat-label">${label}</div>
                <div class="td-stat-value" style="color:${color}">
                    ${value}<span class="td-stat-unit">${unit}</span>
                </div>
                <div class="td-stat-sub">${sub}</div>
            </div>`;
        }

        const kBtns = [1,2].map(k =>
            `<button class="td-btn${_kanal===k?' k-active':''}" onclick="tdKanal(${k})">
                Kanal ${k} &nbsp;(Soll${k} / Ist${k})
             </button>`
        ).join('');

        const aBtns = [
            { id:'verlauf',    l:'Soll / Ist Verlauf' },
            { id:'fehler',     l:'Fehler-Verlauf'     },
            { id:'histogramm', l:'Histogramm'         },
        ].map(a =>
            `<button class="td-btn${_ansicht===a.id?' a-active':''}" onclick="tdAnsicht('${a.id}')">
                ${a.l}
             </button>`
        ).join('');

        const titles = {
            verlauf    : 'Soll-Temperatur (Zielkurve) vs. Ist-Temperatur — Abstand = Regelabweichung',
            fehler     : `Fehler(t) = Ist${_kanal}(t) − Soll${_kanal}(t) &nbsp;·&nbsp; Positiv = zu warm &nbsp;·&nbsp; Negativ = zu kalt`,
            histogramm : 'Häufigkeitsverteilung der Fehler aller ausgewählten Maschinen — idealerweise eng um 0 °C verteilt'
        };

        document.getElementById('tdRoot').innerHTML = `
            <div style="margin-bottom:18px">
                <h4 style="margin:0 0 4px;font-weight:700">🌡 Temperatur-Analyse</h4>
                <p style="margin:0;color:var(--md-text-2);font-size:13px">
                    ${_daten.punkte.length} Messpunkte · ${anzahlMaschinen} ${anzahlMaschinen === 1 ? 'Maschine' : 'Maschinen'} · Kanal ${_kanal} aktiv
                </p>
            </div>

            <div class="td-btns">${kBtns}</div>

            <div class="td-stat-grid">
                ${sc('Bias (Mittelwert)', s.bias,      '°C', s.bias>=0 ? C.ist : C.neg, 'Systematische Abweichung')}
                ${sc('RMSE',             s.rmse,      '°C', C.purple,                  'Ø Quadratischer Fehler'  )}
                ${sc('Std. Abweichung',  s.std,       '°C', C.soll,                    'Rauschen / Instabilität' )}
                ${sc('Max. |Fehler|',    s.maxFehler, '°C', C.neg,                     'Größter Ausreißer'       )}
                ${sc('Messpunkte',       s.anzahl,    '',   C.fehler,                  'im gewählten Zeitraum'   )}
            </div>

            <div class="td-btns">${aBtns}</div>

            <div class="td-chart-box">
                <div class="td-chart-title">${titles[_ansicht]}</div>
                <div style="position:relative;height:clamp(240px, 55vw, 320px)">
                    <canvas id="tdCanvas"></canvas>
                </div>
            </div>

            ${interpText()}
        `;

        drawChart();
    }

    // ── Öffentliche Umschalter ────────────────────────────────────────────
    window.tdKanal   = k => { _kanal   = k; renderDashboard(); };
    window.tdAnsicht = a => { _ansicht = a; renderDashboard(); };

})();
</script>
