@* Views/Shared/_Layout.cshtml *@
@{
    var aktiverController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    // Menüpunkt hervorheben, wenn er zur aktuellen Seite gehört
    string Aktiv(string controller) =>
        string.Equals(aktiverController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    string AriaAktiv(string controller) =>
        string.Equals(aktiverController, controller, StringComparison.OrdinalIgnoreCase) ? "page" : "false";
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Übersicht") – MaschinenDataein</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="ladebalken" aria-hidden="true"></div>

    <nav class="navbar navbar-expand-xl navbar-dark navbar-md sticky-top">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <i class="bi bi-cpu" aria-hidden="true"></i>
                <span>MaschinenDataein</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Navigation umschalten">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-xl-3 gap-xl-1">
                    <li class="nav-item"><a class="nav-link @Aktiv("Home")" aria-current="@AriaAktiv("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Übersicht</a></li>
                    <li class="nav-item"><a class="nav-link @Aktiv("Leistungsdaten")" aria-current="@AriaAktiv("Leistungsdaten")" asp-controller="LeistungsDaten" asp-action="Index"><i class="bi bi-graph-up-arrow"></i> Leistung</a></li>
                    <li class="nav-item"><a class="nav-link @Aktiv("AbzugsDaten")" aria-current="@AriaAktiv("AbzugsDaten")" asp-controller="Abzugsdaten" asp-action="Index"><i class="bi bi-arrows-expand"></i> Abzug</a></li>
                    <li class="nav-item"><a class="nav-link @Aktiv("TemperaturDaten")" aria-current="@AriaAktiv("TemperaturDaten")" asp-controller="TemperaturDaten" asp-action="Index"><i class="bi bi-thermometer-half"></i> Temperatur</a></li>
                    <li class="nav-item"><a class="nav-link @Aktiv("Alarmdaten")" aria-current="@AriaAktiv("Alarmdaten")" asp-controller="AlarmDaten" asp-action="Index"><i class="bi bi-bell"></i> Alarm</a></li>
                    <li class="nav-item"><a class="nav-link @Aktiv("ZustandsDaten")" aria-current="@AriaAktiv("ZustandsDaten")" asp-controller="ZustandsDaten" asp-action="Index"><i class="bi bi-activity"></i> Zustand</a></li>
                    <li class="nav-item"><a class="nav-link @Aktiv("StoerungsDaten")" aria-current="@AriaAktiv("StoerungsDaten")" asp-controller="StoerungsDaten" asp-action="Index"><i class="bi bi-exclamation-triangle"></i> Störung</a></li>
                    <li class="nav-item"><a class="nav-link @Aktiv("Haeufigkeit")" aria-current="@AriaAktiv("Haeufigkeit")" asp-controller="Haeufigkeit" asp-action="Index"><i class="bi bi-bar-chart"></i> Häufige Meldungen</a></li>
                    <li class="nav-item"><a class="nav-link @Aktiv("Planung")" aria-current="@AriaAktiv("Planung")" asp-controller="Planung" asp-action="Index"><i class="bi bi-calendar-check"></i> Planung</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container-fluid px-lg-4 py-3">
        @RenderBody()
    </main>

    <footer class="fuss no-print">
        <div class="container-fluid px-lg-4 d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.Now.Year MaschinenDataein</span>
            <span class="text-white-50 tastatur-tipp">Tipp: Mit <kbd>←</kbd> <kbd>→</kbd> blättern Sie durch die Seiten</span>
        </div>
    </footer>

    <button type="button" id="nachOben" class="btn btn-primary no-print" aria-label="Nach oben">
        <i class="bi bi-arrow-up" aria-hidden="true"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
