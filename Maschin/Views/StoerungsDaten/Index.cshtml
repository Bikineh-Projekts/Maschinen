@using MaschinenDataein.Models.Data
@model List<StoerungsDaten>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["actionForm"] = "Data";
    ViewData["Title"] = "Störung";
}

<div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2">
    <h1><i class="bi bi-exclamation-triangle text-warning"></i> Störung</h1>
    @if (Model != null && Model.Count > 0)
    {
        <span class="text-muted">@Model.Count.ToString("N0") Einträge</span>
    }
</div>

@await Html.PartialAsync("_PartialFilter")

@if (Model != null && Model.Count > 0)
{
    <div class="tabelle-karte">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="text-end">ID</th>
                        <th>Zeitstempel</th>
                        <th>Maschine</th>
                        <th>Meldung</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-end text-muted">@item.Id</td>
                            <td class="zeit-datum">
                                @item.Timestamp.ToString("dd.MM.yyyy")<span class="zeit-uhr">@item.Timestamp.ToString("HH:mm:ss")</span>
                            </td>
                            <td>@(item.Maschine?.Bezeichnung ?? "–")</td>
                            <td>@(item.Stoerungsmeldung?.Meldung ?? "–")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    @await Html.PartialAsync("_LeerHinweis", Model != null)
}
