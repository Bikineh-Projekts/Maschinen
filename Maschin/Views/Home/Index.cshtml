@using MaschinenDataein.Models.ModelView
@using MaschinenDataein.Models.Data
@using MaschinenDataein.Helper
@model DashboardModelView

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Aktuelle-Übersicht";
    ViewData["actionForm"] = "Index";
}

<h1><i class="bi bi-speedometer2 text-primary"></i> Aktuelle Übersicht</h1>

@if (Model != null)
{
    <form asp-action="Index" asp-controller="Home" method="post">
        @Html.AntiForgeryToken()
        <button id="reload" type="submit" class="btn btn-outline-primary mb-3"><i class="bi bi-arrow-clockwise"></i> Aktualisieren</button> <span class="text-muted small ms-2">aktualisiert sich automatisch jede Minute</span>
    </form>

    @* Leistungsdaten *@
    <div class="table-responsive mt-3">
        <h3>Leistungsdaten</h3>
        @await Html.PartialAsync("_LeistungsdatenTable", Model.LeistungsDatenList ?? new List<LeistungsdatenModelView>())
    </div>

    @* Abzugsdaten *@
    <div class="table-responsive mt-3">
        <h3>Abzugsdaten</h3>
        @await Html.PartialAsync("_AbzugsdatenTable", Model.AbzugsDatenList ?? new List<AbzugsdatenModelView>())
    </div>

    @* Temperaturdaten *@
    <div class="table-responsive mt-3">
        <h3>Temperaturdaten</h3>
        @await Html.PartialAsync("_TemperaturdatenTable", Model.TemperaturDatenList ?? new List<TemperaturdatenModelView>())
    </div>

    @* Alarmdaten *@
    <div class="table-responsive mt-3">
        <h3>Alarmdaten</h3>
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark text-center">
                <tr>
                    <th>Zeitstempel</th>
                    <th>Maschine</th>
                    <th>Meldung</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.AlarmDatenList ?? Enumerable.Empty<Alarmdaten>())
                {
                    var aktiveMeldungen = item.AktiveAlarmNummern()
                        .Select(i => AlarmnamenHelper.Alarmnamen.TryGetValue(i, out var meldung) ? meldung : $"Unbekannter Alarm {i}")
                        .ToList();
                    <tr class="text-center">
                        <td class="text-center" style="white-space:nowrap">
                            @item.Timestamp.ToString("dd.MM.yyyy")
                            <span class="text-muted" style="font-size:11px; margin-left:6px;">
                                @item.Timestamp.ToString("HH:mm:ss")
                            </span>
                        </td>
                        <td>@item.Maschine?.Bezeichnung</td>
                        <td>
                            @if (aktiveMeldungen.Any())
                            {
                                @string.Join(", ", aktiveMeldungen)
                            }
                            else
                            {
                                <span class="text-muted">Keine</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Zustandsdaten *@
    <div class="table-responsive mt-3">
        <h3>Zustandsdaten</h3>
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark text-center">
                <tr>
                    <th>Zeitstempel</th>
                    <th>Maschine</th>
                    <th>Meldung</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ZustandsDatenList ?? Enumerable.Empty<ZustandsDaten>())
                {
                    <tr class="text-center">
                        <td class="text-center" style="white-space:nowrap">
                            @item.Timestamp.ToString("dd.MM.yyyy")
                            <span class="text-muted" style="font-size:11px; margin-left:6px;">
                                @item.Timestamp.ToString("HH:mm:ss")
                            </span>
                        </td>
                        <td>@item.Maschine?.Bezeichnung</td>
                        <td>@item.Zustandsmeldung?.Meldung</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Störungsdaten *@
    <div class="table-responsive mt-3">
        <h3>Störungsdaten</h3>
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark text-center">
                <tr>
                    <th>Zeitstempel</th>
                    <th>Maschine</th>
                    <th>Meldung</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.StoerungsDatenList ?? Enumerable.Empty<StoerungsDaten>())
                {
                    <tr class="text-center">
                        <td class="text-center" style="white-space:nowrap">
                            @item.Timestamp.ToString("dd.MM.yyyy")
                            <span class="text-muted" style="font-size:11px; margin-left:6px;">
                                @item.Timestamp.ToString("HH:mm:ss")
                            </span>
                        </td>
                        <td>@item.Maschine?.Bezeichnung</td>
                        <td>@item.Stoerungsmeldung?.Meldung</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning text-center">
        ❌ Keine Daten verfügbar
    </div>
}

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            setInterval(clickReload, 60000);
        });
        function clickReload() {
            $('#reload').click();
        }
    </script>
}
