@using MaschinenDataein.Models.ModelView
@model List<LeistungsdatenModelView>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["actionForm"] = "Index";
    ViewData["Title"] = "Leistungsdaten";
    ViewData["IsShowId"] = true;
}

<div>
    <h1><i class="bi bi-graph-up-arrow text-primary"></i> Leistungsdaten</h1>

    @await Html.PartialAsync("_PartialFilter")

    @* Tab-Navigation *@
    <ul class="nav seiten-reiter no-print" data-reiter="leistung" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" type="button" role="tab" data-bs-toggle="tab"
                    data-bs-target="#leistTabelle" data-reiter-id="tabelle">
                <i class="bi bi-table" aria-hidden="true"></i> Tabelle
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" type="button" role="tab" data-bs-toggle="tab"
                    data-bs-target="#leistChart" data-reiter-id="analyse" data-beim-zeigen="ladeLeistungChart">
                <i class="bi bi-bar-chart-line" aria-hidden="true"></i> Analyse
            </button>
        </li>
    </ul>

    <div class="tab-content">

        @* TAB 1: Tabelle *@
        <div class="tab-pane fade show active" id="leistTabelle" role="tabpanel">
            @await Html.PartialAsync("_LeistungsdatenTable", Model)
        </div>

        @* TAB 2: Chart *@
        <div class="tab-pane fade" id="leistChart" role="tabpanel">
            @await Html.PartialAsync("_LeistungsdatenChart")
        </div>

    </div>
</div>
