@using MaschinenDataein.Models.ModelView
@model List<TemperaturdatenModelView>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["actionForm"] = "Index";
    ViewData["Title"] = "Temperaturdaten";
    ViewData["IsShowId"] = true;
}

<div>
    <h1><i class="bi bi-thermometer-half text-danger"></i> Temperaturdaten</h1>

    @await Html.PartialAsync("_PartialFilter")

    @* Tab-Navigation *@
    <ul class="nav seiten-reiter no-print" data-reiter="temperatur" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" type="button" role="tab" data-bs-toggle="tab"
                    data-bs-target="#tabelle" data-reiter-id="tabelle">
                <i class="bi bi-table" aria-hidden="true"></i> Tabelle
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" type="button" role="tab" data-bs-toggle="tab"
                    data-bs-target="#chart" data-reiter-id="analyse" data-beim-zeigen="ladeChartDaten">
                <i class="bi bi-bar-chart-line" aria-hidden="true"></i> Analyse
            </button>
        </li>
    </ul>

    <div class="tab-content" id="tempTabContent">

        @* TAB 1: Tabelle *@
        <div class="tab-pane fade show active" id="tabelle" role="tabpanel">
            @await Html.PartialAsync("_TemperaturdatenTable", Model)
        </div>

        @* TAB 2: Chart-Dashboard *@
        <div class="tab-pane fade" id="chart" role="tabpanel">
            @await Html.PartialAsync("_TemperaturdatenChart")
        </div>

    </div>
</div>
